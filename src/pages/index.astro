---
import '../styles/base.css';
import ClientLayout from '../layouts/ClientLayout.astro';
import { getClientPages, stripExt } from '../lib/clientPages';
import { clients } from '../lib/clients';
import { buildNavigation } from '../lib/navigation';

const clientSlug = Astro.locals.clientSlug;
const unknownClient = Astro.locals.unknownClient;
const userEmail = Astro.locals.userEmail ?? null;

let clientContent = null;

// Only handle the root path for client content, let catchall handle sub-pages
if (clientSlug && clients[clientSlug] && !unknownClient && Astro.url.pathname === '/') {
  const client = clients[clientSlug];
  const entries = await getClientPages(clientSlug);

  // Look for the client's index page
  const entry = entries.find((e) => stripExt(e.id) === `${clientSlug}/index`);
  
  if (entry) {
    const nav = buildNavigation(entries, clientSlug);
    
    const { Content } = await entry.render();
    const pageTitle = entry.data.title;
    const pageDescription = entry.data.description ?? null;
    
    clientContent = {
      client: { ...client, nav },
      userEmail,
      pageTitle,
      pageDescription,
      Content
    };
  }
}

// Landing page variables
const host = Astro.request.headers.get('host') || '';
const isPreview = host.endsWith('.pages.dev');

// The demo tenant cards below link via ?as=<slug>. That only resolves where the
// override is actually honored — localhost, or a *.pages.dev host with
// ALLOW_TENANT_OVERRIDE=true. On a custom domain it never is, so offering those
// links there would be advertising dead ends, and would also publish the tenant
// list on what may be a public apex. Tenants are reached by subdomain instead.
const canUseOverride = Astro.locals.overrideAllowed === true;

// A hostname that resolves to a slug with no registry entry must not quietly
// serve the marketing landing page: that makes a typo'd DNS record or a
// half-finished tenant look like a working deployment. Sub-paths already
// returned the "unknown client" page via [...catchall]; the root now agrees.
const isUnknownTenant =
  Boolean(clientSlug) && (unknownClient === true || !clients[clientSlug!]);
if (isUnknownTenant) {
  Astro.response.status = 404;
}
---

{clientContent ? (
  <ClientLayout client={clientContent.client} userEmail={clientContent.userEmail} title={clientContent.pageTitle}>
    <section class="page-header">
      <h1 class="page-title">{clientContent.pageTitle}</h1>
      {clientContent.pageDescription && (
        <p class="page-description">{clientContent.pageDescription}</p>
      )}
    </section>
    <article class="prose-content">
      <clientContent.Content />
    </article>
  </ClientLayout>
) : isUnknownTenant ? (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Unknown client</title>
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-900">
      <main class="mx-auto max-w-3xl p-6">
        <h1 class="mb-2 text-2xl font-bold">Unknown client</h1>
        <p>
          The client <strong>{clientSlug}</strong> is not configured. If this is a preview or a new
          client, ensure content exists in <code>/content/clients/{clientSlug}</code> and that the
          registry in <code>src/lib/clients.ts</code> includes it.
        </p>
      </main>
    </body>
  </html>
) : (
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Multi-Client Astro — One Codebase, Many Sites</title>
      <meta name="description" content="Serve many client sites from one Astro codebase. The hostname decides which tenant's content, theme, and navigation a visitor gets." />
    </head>
    <body class="min-h-screen bg-gradient-to-b from-slate-50 to-slate-100 text-slate-900">
      <main class="mx-auto max-w-6xl p-6">
        <section class="relative overflow-hidden rounded-2xl border bg-white shadow-lg">
          <div class="absolute inset-0 bg-gradient-to-r from-blue-50 via-indigo-50 to-purple-50"></div>
          <div class="relative p-8 md:p-12">
            <div class="mx-auto max-w-3xl text-center">
              <div class="mb-6 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-sm">
                <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                <span class="text-sm font-medium text-slate-600">Multi-Client Astro</span>
              </div>
              <h1 class="mb-4 text-4xl font-bold tracking-tight text-slate-900 md:text-5xl">
                One Codebase.<br />Many Client Sites.
              </h1>
              <p class="mb-8 text-lg text-slate-600">
                The hostname decides which tenant's content, theme, and navigation a visitor gets.
                Everything else is shared.
              </p>
              <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="https://github.com/keyanfayaz/client-sites" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-6 py-3 font-semibold text-white hover:bg-slate-800 transition-colors">
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  View on GitHub
                </a>
                {canUseOverride && (
                  <a href="#demo-sites" class="inline-flex items-center gap-2 rounded-lg border-2 border-slate-300 px-6 py-3 font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
                    View the demo tenants
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>

        <section class="mt-12">
          <h2 class="mb-6 text-center text-2xl font-bold text-slate-900">What it does</h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <div class="rounded-xl border bg-white p-6 shadow-sm">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-blue-100">
                <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-slate-900">Hostname routing</h3>
              <p class="text-sm text-slate-600">Middleware maps the subdomain to a tenant slug, so acme.example.com and beta.example.com serve different content from one deployment.</p>
            </div>
            <div class="rounded-xl border bg-white p-6 shadow-sm">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-indigo-100">
                <svg class="h-6 w-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-slate-900">Per-tenant theming</h3>
              <p class="text-sm text-slate-600">Colors, logo, and navigation come from one registry entry per tenant, applied as CSS custom properties rather than forked components.</p>
            </div>
            <div class="rounded-xl border bg-white p-6 shadow-sm">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-purple-100">
                <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-slate-900">MDX content</h3>
              <p class="text-sm text-slate-600">Pages are MDX files with Zod-checked frontmatter. Navigation is built from those files, so adding a page adds a nav entry.</p>
            </div>
            <div class="rounded-xl border bg-white p-6 shadow-sm">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-indigo-100">
                <svg class="h-6 w-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-slate-900">Identity gating</h3>
              <p class="text-sm text-slate-600">Put a tenant behind Cloudflare Access and the app reads the signed-in email from the request headers. It never handles sign-in itself.</p>
            </div>
            <div class="rounded-xl border bg-white p-6 shadow-sm">
              <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-lg bg-purple-100">
                <svg class="h-6 w-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="mb-2 text-lg font-semibold text-slate-900">Edge rendering</h3>
              <p class="text-sm text-slate-600">Astro 4 in SSR mode on Cloudflare Pages Functions, so pages render at the edge close to the visitor.</p>
            </div>
          </div>
        </section>

        {canUseOverride ? (
        <section id="demo-sites" class="mt-12">
          <h2 class="mb-6 text-center text-2xl font-bold text-slate-900">Demo tenants</h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <a href="/?as=acme" class="group block rounded-xl border-2 border-slate-200 bg-white p-6 shadow-sm transition-all hover:border-blue-500 hover:shadow-md">
              <div class="mb-3 flex items-center gap-3">
                <div class="h-10 w-10 rounded bg-blue-600"></div>
                <div>
                  <h3 class="text-lg font-semibold text-slate-900 group-hover:text-blue-600">Acme Corp</h3>
                  <p class="text-sm text-slate-500">Internal knowledge base</p>
                </div>
              </div>
              <p class="text-sm text-slate-600">An identity-gated employee wiki: onboarding, handbook, playbooks, and training. Gated at the edge by Cloudflare Access.</p>
            </a>
            <a href="/?as=beta" class="group block rounded-xl border-2 border-slate-200 bg-white p-6 shadow-sm transition-all hover:border-green-500 hover:shadow-md">
              <div class="mb-3 flex items-center gap-3">
                <div class="h-10 w-10 rounded bg-green-600"></div>
                <div>
                  <h3 class="text-lg font-semibold text-slate-900 group-hover:text-green-600">Beta Industries</h3>
                  <p class="text-sm text-slate-500">Public marketing site</p>
                </div>
              </div>
              <p class="text-sm text-slate-600">A public company site with services, technology, case studies, pricing, and contact pages. No gate in front of it.</p>
            </a>
          </div>
          <p class="mt-4 text-center text-sm text-slate-500">
            On this host, tenants are selected with <code>?as=&lt;slug&gt;</code> because there is no
            wildcard DNS in front of it. A production deployment serves them from subdomains
            instead (e.g. acme.example.com, beta.example.com), resolved from the hostname.
          </p>
        </section>
        ) : (
        <section id="demo-sites" class="mt-12">
          <h2 class="mb-3 text-center text-2xl font-bold text-slate-900">Tenants</h2>
          <p class="mx-auto max-w-2xl text-center text-sm text-slate-600">
            Tenants on this deployment are served from their own subdomains and resolved from the
            request hostname. The <code>?as=&lt;slug&gt;</code> override is not available here — it
            works on <code>localhost</code>, and on a <code>*.pages.dev</code> host only when
            <code>ALLOW_TENANT_OVERRIDE=true</code> is set.
          </p>
        </section>
        )}

        <section class="mt-12 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-lg">
          <div class="mx-auto max-w-3xl text-center">
            <h2 class="mb-4 text-3xl font-bold">Run it yourself</h2>
            <p class="mb-6 text-lg text-blue-100">
              Clone it, install, and run. No environment variables required.
            </p>
            <div class="rounded-lg bg-slate-900 p-4 text-left">
              <code class="text-sm text-green-400">
                git clone https://github.com/keyanfayaz/client-sites.git<br />
                cd client-sites<br />
                pnpm install<br />
                pnpm dev
              </code>
            </div>
            <p class="mt-6 text-sm text-blue-100">
              Check out the <a href="https://github.com/keyanfayaz/client-sites#readme" class="underline hover:text-white">README</a> for full documentation.
            </p>
          </div>
        </section>

        {isPreview && (
          <p class="mt-8 rounded bg-yellow-50 p-3 text-sm text-yellow-900">
            Preview deployment detected. Robots are blocked via <code>X-Robots-Tag: noindex</code>.
          </p>
        )}
      </main>
    </body>
  </html>
)}