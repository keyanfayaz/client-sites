---
import '../styles/base.css';
import type { ClientConfig } from '../lib/clients';

type Props = {
  client: ClientConfig;
  userEmail?: string | null;
  title?: string;
};

const { client, userEmail, title } = Astro.props as Props;
const pageTitle = title ? `${title} — ${client.name}` : client.name;

// The ?as=<slug> tenant override is honored on localhost and *.pages.dev
// (see middleware.ts). Propagate it across navigation so tenant context
// survives a page change. On a real subdomain host the hostname already
// carries the slug, so links stay clean.
const currentUrl = new URL(Astro.request.url);
const searchParams = currentUrl.searchParams.toString();
const queryString = searchParams ? `?${searchParams}` : '';
const hasSlugOverride = currentUrl.searchParams.has('as');

// Helper function to create URLs with preserved query params
function createNavUrl(path: string) {
  const cleanPath = path.startsWith('/') ? path : `/${path}`;
  return hasSlugOverride ? `${cleanPath}${queryString}` : cleanPath;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <div
      class="theme flex min-h-screen flex-col"
      style={`--color-primary:${client.theme.primary}; --color-accent:${client.theme.accent};`}
    >
      <header class="border-b bg-white">
        <div class="mx-auto max-w-6xl">
          <div class="flex items-center justify-between gap-6 p-4">
            <div class="flex items-center gap-6">
              <a href={createNavUrl("/")} class="flex items-center gap-3">
                <div class="h-8 w-8 rounded bg-[color:var(--color-primary)]"></div>
                <span class="text-lg font-semibold">{client.name}</span>
              </a>
              <nav class="flex items-center gap-3">
                {(client.nav ?? []).map((n) => (
                  <a class="text-sm text-gray-700 hover:text-[color:var(--color-primary)]" href={createNavUrl(n.path)}
                    >{n.label}</a
                  >
                ))}
              </nav>
            </div>
            <div class="flex items-center gap-3">
              <div class="text-sm text-gray-500">
                {userEmail ? (
                  <span>Hi, {userEmail}</span>
                ) : (
                  <span class="italic">Not signed in</span>
                )}
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="flex-1 mx-auto max-w-6xl p-6">
        <slot />
      </main>

      <footer class="border-t bg-white">
        <div class="mx-auto max-w-6xl p-4 text-sm text-gray-500">
          Powered by Multi-Client Astro
        </div>
      </footer>
    </div>
    <script>
      // Links written inside MDX content are plain paths like "/pricing". When the
      // tenant comes from ?as=<slug> rather than the hostname, those links would drop
      // the slug and bounce back to the landing page, so carry the query string over.
      // On a real subdomain host there is no ?as= and this is a no-op.
      document.addEventListener('DOMContentLoaded', function () {
        const currentParams = new URLSearchParams(window.location.search);
        if (!currentParams.has('as')) return;

        document.querySelectorAll('main a[href^="/"]').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href || href.includes('?') || href.includes('://')) return;
          // Keep any #fragment after the query string.
          const [path, hash] = href.split('#');
          link.setAttribute(
            'href',
            `${path}?${currentParams.toString()}${hash ? `#${hash}` : ''}`
          );
        });
      });
    </script>
  </body>
  
</html>

