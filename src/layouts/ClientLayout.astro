---
import '../styles/base.css';
import type { ClientConfig } from '../lib/clients';

type Props = {
  client: ClientConfig;
  userEmail?: string | null;
  title?: string;
};

const { client, userEmail, title } = Astro.props as Props;
const pageTitle = title ? `${title} — ${client.name}` : client.name;

// Preserve query parameters and full URLs for local development
const currentUrl = new URL(Astro.request.url);
const searchParams = currentUrl.searchParams.toString();
const queryString = searchParams ? `?${searchParams}` : '';

// Check if we're in local development
const isLocalDev = currentUrl.hostname === 'localhost' || currentUrl.hostname === '127.0.0.1';

// Helper function to create URLs with preserved query params
function createNavUrl(path: string) {
  if (isLocalDev) {
    // For local development, use full URL with protocol, host, and port
    const baseUrl = `${currentUrl.protocol}//${currentUrl.host}`;
    // Ensure path starts with / but avoid double slashes
    const cleanPath = path.startsWith('/') ? path : `/${path}`;
    return `${baseUrl}${cleanPath}${queryString}`;
  } else {
    // For production, use relative URLs (no query params needed)
    return path;
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <div
      class="theme flex min-h-screen flex-col"
      style={`--color-primary:${client.theme.primary}; --color-accent:${client.theme.accent};`}
    >
      <header class="border-b bg-white">
        <div class="mx-auto max-w-6xl">
          <div class="flex items-center justify-between gap-6 p-4">
            <div class="flex items-center gap-6">
              <a href={createNavUrl("/")} class="flex items-center gap-3">
                <div class="h-8 w-8 rounded bg-[color:var(--color-primary)]"></div>
                <span class="text-lg font-semibold">{client.name}</span>
              </a>
              <nav class="flex items-center gap-3">
                {client.nav.map((n) => (
                  <a class="text-sm text-gray-700 hover:text-[color:var(--color-primary)]" href={createNavUrl(n.path)}
                    >{n.label}</a
                  >
                ))}
              </nav>
            </div>
            <div class="flex items-center gap-3">
              <div class="text-sm text-gray-500">
                {userEmail ? (
                  <span>Hi, {userEmail}</span>
                ) : (
                  <span class="italic">Not signed in</span>
                )}
              </div>
            </div>
          </div>
        </div>
      </header>

      <main class="flex-1 mx-auto max-w-6xl p-6">
        <slot />
      </main>

      <footer class="border-t bg-white">
        <div class="mx-auto max-w-6xl p-4 text-sm text-gray-500">
          Powered by Multi-Client Astro
        </div>
      </footer>
    </div>
    <script>
      // Preserve query parameters for content links in local development
      document.addEventListener('DOMContentLoaded', function() {
        const currentParams = new URLSearchParams(window.location.search);
        
        // Only apply this for local development with query parameters
        if (window.location.hostname === 'localhost' && currentParams.toString()) {
          // Only target links in the main content area, not navigation
          const contentLinks = document.querySelectorAll('main a[href^="/"]');
          
          contentLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href && href.startsWith('/')) {
              // Don't modify if it already has query parameters or is already a full URL
              if (!href.includes('?') && !href.includes('://')) {
                const fullUrl = `${window.location.protocol}//${window.location.host}${href}?${currentParams.toString()}`;
                link.setAttribute('href', fullUrl);
              }
            }
          });
        }
      });
    </script>
  </body>
  
</html>

