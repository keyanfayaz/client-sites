# Cloudflare Pages header rules. Header lines must be indented under their path.
# Frame and CSP headers are set per-request in src/middleware.ts, because they
# depend on whether the request resolved to a tenant.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=15552000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cache-Control: no-cache

# Astro emits content-hashed filenames here, so these are safe to cache forever.
# Without this the blanket no-cache above would defeat asset caching entirely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=86400

/*.md
  Content-Type: text/markdown; charset=utf-8
